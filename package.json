{
  "name": "@y1x1n/dsh-prompt-optimizer",
  "version": "0.6.3",
  "description": "DeepSeek Harness 插件:在发送栏旁一键分析并优化提示词(复用当前会话模型)。适配 dsh 0.2.1-rc.5(含官方桌面端)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y1X1n/dsh-prompt-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/Y1X1n/dsh-prompt-optimizer/issues"
  },
  "homepage": "https://github.com/Y1X1n/dsh-prompt-optimizer#readme",
  "keywords": [
    "deepseek",
    "dsh",
    "harness",
    "prompt",
    "optimizer",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0-rc.7 <0.3.0-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "sync:types": "node scripts/sync-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs && node test/prompt.test.mjs && node test/controller.test.mjs && node test/slot-guard.test.mjs && node test/upstream-contract.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "typescript": "^5.5.0"
  }
}
